		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.5",
		"highlight.js": "11.11.1",
		"prettier": "^3.8.3",
		"ts-node": "^10.9.2",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.59.3",
		"vite": "^8.0.13",
		"vite-plugin-html": "^3.2.2"
